{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "eq": "fpc.stagmkt.dev" } }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, noimageindex" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "suf": ".vercel.app" } }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, noimageindex" }]
    }
  ]
}
